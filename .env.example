# 环境变量约定（复制为 .env 后按需修改；.env 已在 .gitignore 中）

# ── App 1 后端 ──
# Task 1 ML 容器地址：本地开发用 localhost；docker-compose 内用服务名 http://ml-model:8000
ML_MODEL_URL=http://localhost:8000

# SQLite 数据库文件路径（相对 app1-backend 工作目录；aiosqlite 异步驱动）
DATABASE_URL=sqlite+aiosqlite:///./estimates.db

# 允许的前端开发源（CORS）
CORS_ORIGINS=http://localhost:3000
